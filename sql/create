--工单状态流转表
CREATE TABLE IF NOT EXISTS `order_status_flow` (
  `id` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT COMMENT '主键ID，自增',
  `order_id` VARCHAR(64) NOT NULL COMMENT '全局工单ID（与dispatch/schedule表order_id一致）',
  `fault_id` BIGINT UNSIGNED NOT NULL COMMENT '关联fault表主键ID',
  `dispatch_id` BIGINT UNSIGNED DEFAULT NULL COMMENT '关联dispatch表主键ID（派单后填充）',
  `schedule_id` BIGINT UNSIGNED DEFAULT NULL COMMENT '关联schedule表主键ID（排期后填充）',
  `worker_id` VARCHAR(32) DEFAULT NULL COMMENT '关联worker表工人ID（派单后填充）',
  `current_status` TINYINT NOT NULL COMMENT '当前工单状态（1-待识别，2-识别完成，3-待派单，4-派单完成，5-待排期，6-排期完成，7-维修中，8-待验收，9-验收完成，10-工单关闭）',
  `status_name` VARCHAR(32) NOT NULL COMMENT '当前状态描述（与current_status对应）',
  `status_remark` VARCHAR(256) DEFAULT '' COMMENT '状态备注（如验收不通过原因/派单失败原因）',
  `status_update_time` DATETIME NOT NULL COMMENT '状态更新时间',
  `creator` VARCHAR(64) DEFAULT 'system' COMMENT '工单创建者（system-系统自动/用户名-人工创建）',
  `finish_time` DATETIME DEFAULT NULL COMMENT '工单完成时间（验收完成后填充）',
  `gmt_create` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '记录创建时间',
  `gmt_modified` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '记录修改时间',
  `is_deleted` TINYINT(1) NOT NULL DEFAULT 0 COMMENT '逻辑删除标记',
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_order_id` (`order_id`) COMMENT '全局工单ID唯一',
  KEY `idx_fault_id` (`fault_id`),
  KEY `idx_worker_id` (`worker_id`),
  KEY `idx_current_status` (`current_status`),
  KEY `idx_status_update_time` (`status_update_time`),
  CONSTRAINT `fk_order_status_flow_fault_id` FOREIGN KEY (`fault_id`) REFERENCES `fault` (`id`) ON DELETE CASCADE ON UPDATE CASCADE,
  CONSTRAINT `fk_order_status_flow_dispatch_id` FOREIGN KEY (`dispatch_id`) REFERENCES `dispatch` (`id`) ON DELETE SET NULL ON UPDATE CASCADE,
  CONSTRAINT `fk_order_status_flow_schedule_id` FOREIGN KEY (`schedule_id`) REFERENCES `schedule` (`id`) ON DELETE SET NULL ON UPDATE CASCADE,
  CONSTRAINT `fk_order_status_flow_worker_id` FOREIGN KEY (`worker_id`) REFERENCES `worker` (`id`) ON DELETE SET NULL ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='工单全生命周期状态流转表';

-- 创建用户信息表
CREATE TABLE `sys_user` (
  `id` bigint NOT NULL AUTO_INCREMENT COMMENT '用户ID',
  `username` varchar(50) NOT NULL COMMENT '用户名/登录账号',
  `password` varchar(100) NOT NULL COMMENT '加密后的密码',
  `real_name` varchar(50) NOT NULL COMMENT '用户姓名',
  `latitude` decimal(10,6) DEFAULT NULL COMMENT '纬度',
  `longitude` decimal(10,6) DEFAULT NULL COMMENT '经度',
  `last_login_time` datetime DEFAULT NULL COMMENT '最后登录时间',
  `last_login_ip` varchar(50) DEFAULT NULL COMMENT '最后登录IP',
  `status` tinyint NOT NULL DEFAULT '1' COMMENT '状态 1-正常 0-禁用',
  `create_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `update_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_username` (`username`) COMMENT '用户名唯一',
  KEY `idx_status` (`status`) COMMENT '状态索引'
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='用户信息表';

